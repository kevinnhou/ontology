{
  "name": "@ontology/vision",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "uv run --env-file .env uvicorn vision.main:app --reload --host 0.0.0.0 --port 8000",
    "start": "uv run vision-worker",
    "start:api": "uv run uvicorn vision.main:app --host 0.0.0.0 --port 8000",
    "lint": "uv run ruff check src tests",
    "lint:fix": "uv run ruff check --fix src tests",
    "typecheck": "basedpyright",
    "typecheck:ty": "uv run ty check",
    "test": "uv run pytest"
  },
  "devDependencies": {
    "basedpyright": "^1.39.9"
  }
}
